@using Microsoft.AspNetCore.Components.Authorization
@using GestionConge.Client.Services
@using GestionConge.Client.Models
@using GestionConge.Client.Extensions
@using GestionConge.Client.Helpers
@inject AuthenticationStateProvider AuthStateProvider
@inject ValidationService ValidationService

<div class="d-flex flex-column" style="height: 100%;">
    <!-- Header du menu -->
    <div class="pa-4 text-center">
        <MudAvatar Size="Size.Large" Color="Color.Primary">
            @if (!string.IsNullOrEmpty(CurrentUser?.Avatar))
            {
                <MudImage Src="@CurrentUser.Avatar" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            }
        </MudAvatar>
        <MudText Typo="Typo.subtitle1" Class="mt-2">
            @(CurrentUser?.Nom ?? "Utilisateur")
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @GetUserRole()
        </MudText>
    </div>

    <MudDivider />

    <!-- Menu de navigation -->
    <MudNavMenu Class="flex-grow-1 pa-2">
        <MudNavLink Href="/dashboard"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Dashboard"
                    IconColor="Color.Primary">
            Dashboard
        </MudNavLink>

        <MudNavGroup Text="Demandes de congés"
                     Icon="@Icons.Material.Filled.EventNote"
                     Expanded="true">
            <MudNavLink Href="/demande-form/nouvelle"
                        Icon="@Icons.Material.Filled.Add"
                        IconColor="Color.Info">
                Nouvelle demande
            </MudNavLink>
            <MudNavLink Href="/demandes"
                        Icon="@Icons.Material.Filled.List"
                        IconColor="Color.Success">
                Mes demandes
            </MudNavLink>
            <MudNavLink Href="/validations"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.TaskAlt"
                        IconColor="Color.Warning">
                <div class="d-flex align-center justify-space-between w-100">
                    <span>Validations</span>
                    @if (_pendingValidations > 0)
                    {
                        <MudBadge Content="@_pendingValidations"
                                  Color="Color.Error"
                                  Class="ml-auto" />
                    }
                </div>
            </MudNavLink>
            <MudNavLink Href="/notifications"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Notifications"
                        IconColor="Color.Secondary">
                <div class="d-flex align-center justify-space-between w-100">
                    <span>Notifications</span>
                    @if (NotificationCount > 0)
                    {
                        <MudBadge Content="@NotificationCount"
                                  Color="Color.Error"
                                  Class="ml-auto" />
                    }
                </div>
            </MudNavLink>
        </MudNavGroup>

        <!-- Menu visible pour les managers et admins -->
        <AuthorizeView Roles="Admin,DOT">
            <Authorized>
                <MudNavGroup Text="Management"
                             Icon="@Icons.Material.Filled.SupervisorAccount"
                             IconColor="Color.Secondary">
                    <MudNavLink Href="/management/equipe"
                                Icon="@Icons.Material.Filled.Group"
                                IconColor="Color.Info">
                        Mon équipe
                    </MudNavLink>
                    <MudNavLink Href="/management/planning"
                                Icon="@Icons.Material.Filled.CalendarMonth"
                                IconColor="Color.Success">
                        Planning équipe
                    </MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>

        <MudNavLink Href="/planning"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.CalendarToday"
                    IconColor="Color.Tertiary">
            Planning personnel
        </MudNavLink>

        <MudNavLink Href="/statistiques"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.Analytics"
                    IconColor="Color.Tertiary">
            Statistiques
        </MudNavLink>

        <MudDivider Class="my-2" />

        <!-- Section Administration (visible seulement pour les admins) -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudNavGroup Text="Administration"
                             Icon="@Icons.Material.Filled.AdminPanelSettings"
                             IconColor="Color.Error">
                    <MudNavLink Href="/admin/utilisateurs"
                                Icon="@Icons.Material.Filled.People"
                                IconColor="Color.Info">
                        Utilisateurs
                    </MudNavLink>
                    <MudNavLink Href="/admin/parametres"
                                Icon="@Icons.Material.Filled.Settings"
                                IconColor="Color.Default">
                        Paramètres système
                    </MudNavLink>
                    <MudNavLink Href="/admin/rapports"
                                Icon="@Icons.Material.Filled.Assessment"
                                IconColor="Color.Warning">
                        Rapports
                    </MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>

    <!-- Footer du menu -->
    <div class="pa-4 mt-auto">
        <MudDivider Class="mb-3" />
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Help"
                   FullWidth="true"
                   Size="Size.Small"
                   Class="justify-start"
                   Href="/aide">
            Aide & Support
        </MudButton>
        <MudText Typo="Typo.caption"
                 Class="text-center mt-2 mud-text-secondary">
            Version 1.1.2
        </MudText>
    </div>
</div>

@code {
    [Parameter] public UtilisateurDto? CurrentUser { get; set; }
    [Parameter] public int NotificationCount { get; set; } = 0;

    private int _pendingValidations = 0;

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentUser != null)
        {
            await LoadPendingValidationsAsync();
        }
    }

    private async Task LoadPendingValidationsAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole("Manager") || authState.User.IsInRole("Admin") || authState.User.IsInRole("DOT"))
        {
            try
            {
                var result = await ValidationService.GetPendingValidationsCountAsync();
                if (result.IsSuccess)
                {
                    _pendingValidations = result.Data;
                    StateHasChanged();
                }
            }
            catch
            {
                // Gestion silencieuse des erreurs pour ne pas casser l'UI
                _pendingValidations = 0;
            }
        }
    }

    private string GetUserRole()
    {
        if (CurrentUser is null) return "Utilisateur";

        // Logique pour déterminer le rôle affiché
        if (CurrentUser.Role?.Contains("Admin") == true)
            return "Administrateur";
        if (CurrentUser.Role?.Contains("DOT") == true)
            return "Directeur";

        return "Employé";
    }
}