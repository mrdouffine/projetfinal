@page "/demande-form/nouvelle"
@page "/demande-form/modifier/{Id:int}"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using GestionConge.Client.Models
@using GestionConge.Client.Services
@inject DemandeCongeService DemandeService
@inject UserService UtilisateurService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@(_isEditMode ? "Modifier la demande" : "Nouvelle demande") - GCO</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@(_isEditMode? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-3" />
        @(_isEditMode ? "Modifier votre demande de congés" : "Créer une nouvelle demande de congés")
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Veuillez remplir le formulaire ci-dessous pour soumettre votre demande.
    </MudText>

    <MudGrid>
        <!-- Informations du solde -->
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 text-center" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.h5">@_soldeConges.CongesPayes</MudText>
                        <MudText Typo="Typo.body2">Congés payés disponibles</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 text-center" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.h5">@_soldeConges.RTT</MudText>
                        <MudText Typo="Typo.body2">RTT disponibles</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4 text-center" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.h5">@_soldeConges.UtilisesCeMois</MudText>
                        <MudText Typo="Typo.body2">Utilisés ce mois</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>

        <!-- Formulaire -->
        <MudItem xs="12" md="8">
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
                        Informations de la demande
                    </MudText>
                </MudCardHeader>
                <MudCardContent>
                    <EditForm Model="_demandeModel" OnValidSubmit="HandleSubmit">
                        <MudGrid>
                            @if (_isEditMode && _currentDemande != null)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Label="Statut" Variant="Variant.Outlined" Value="@_currentDemande.Statut" ReadOnly="true" />
                                </MudItem>
                            }

                            <MudItem xs="12" sm="6">
                                <MudDatePicker @bind-Date="_demandeModel.DateDebut"
                                               @bind-Date:after="OnDateChanged"
                                               Label="Date de début"
                                               Variant="Variant.Outlined"
                                               Required="true"
                                               MinDate="DateTime.Today.AddDays(1)" />
                                <ValidationMessage For="@(() => _demandeModel.DateDebut)" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudDatePicker @bind-Date="_demandeModel.DateFin"
                                               @bind-Date:after="OnDateChanged"
                                               Label="Date de fin"
                                               Variant="Variant.Outlined"
                                               Required="true"
                                               MinDate="_demandeModel.DateDebut" />
                                <ValidationMessage For="@(() => _demandeModel.DateFin)" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField T="int" Label="Nombre de jours" Variant="Variant.Outlined" Value="@_calculatedDays" ReadOnly="true" HelperText="Calculé automatiquement (jours ouvrés)" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudCheckBox T="bool" @bind-Checked="_demandeModel.DemiJournee" @bind-Checked:after="OnDateChanged" Label="Demi-journée (premier/dernier jour)" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="_demandeModel.Motif" Label="Motif" Variant="Variant.Outlined" Lines="3" Counter="500" MaxLength="500" />
                                <ValidationMessage For="@(() => _demandeModel.Motif)" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudCheckBox T="bool" @bind-Checked="_demandeModel.Confirmation" Required="true" Label="Je confirme que les informations saisies sont exactes et que j'ai vérifié mon solde de congés" />
                                <ValidationMessage For="@(() => _demandeModel.Confirmation)" />
                            </MudItem>
                        </MudGrid>

                        <MudCardActions Class="pt-4">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isLoading"
                                       StartIcon="@(_isEditMode ? Icons.Material.Filled.Save : Icons.Material.Filled.Send)">
                                @if (_isLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    @(_isEditMode ? "Modification..." : "Soumission...")
                                }
                                else
                                {
                                    @(_isEditMode ? "Modifier la demande" : "Soumettre la demande")
                                }
                            </MudButton>
                            @if (_isEditMode)
                            {
                                <MudButton Variant="Variant.Outlined" OnClick="ResetForm" Class="ml-2">
                                    Annuler les modifications
                                </MudButton>
                            }
                        </MudCardActions>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Panneau d'aide -->
        <MudItem xs="12" md="4">
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                            Informations utiles
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudList T="string">
                        <MudListItem Icon="@Icons.Material.Filled.AccessTime" IconColor="Color.Primary">
                            <div>
                                <MudText Typo="Typo.subtitle2">Délais</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Les demandes doivent être soumises au moins 2 semaines avant la date de début.
                                </MudText>
                            </div>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Approval" IconColor="Color.Info">
                            <div>
                                <MudText Typo="Typo.subtitle2">Validation</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Votre manager dispose de 5 jours ouvrés pour valider votre demande.
                                </MudText>
                            </div>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Warning">
                            <div>
                                <MudText Typo="Typo.subtitle2">Modifications</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Vous pouvez modifier une demande si elle n'a pas encore été validée.
                                </MudText>
                            </div>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Cancel" IconColor="Color.Error">
                            <div>
                                <MudText Typo="Typo.subtitle2">Annulation</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Une demande approuvée ne peut être annulée que 48h avant le début.
                                </MudText>
                            </div>
                        </MudListItem>
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    [Parameter] public int? Id { get; set; }

    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private bool _isEditMode => Id.HasValue;
    private bool _isLoading = false;
    private bool _disposed = false;
    private int _calculatedDays = 0;

    private DemandeModel _demandeModel = new();
    private DemandeCongeDto? _currentDemande;
    private List<UtilisateurDto> _validateurs = new();
    private SoldeConges _soldeConges = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (_disposed) return;

            await LoadValidateurs();
            await LoadSoldeConges();

            if (_isEditMode)
            {
                await LoadExistingDemande();
            }
            else
            {
                _demandeModel.DateDebut = DateTime.Today.AddDays(14);
                _demandeModel.DateFin = DateTime.Today.AddDays(14);
            }

            CalculateNombreJours();
        }
        catch (Exception ex) when (!_disposed)
        {
            Snackbar?.Add($"Erreur lors du chargement : {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadValidateurs()
    {
        if (_disposed) return;

        try
        {
            var result = await UtilisateurService.GetAllAsync();
            if (!_disposed)
            {
                _validateurs = result ?? new();
            }
        }
        catch (Exception ex) when (!_disposed)
        {
            Snackbar?.Add($"Erreur lors du chargement des validateurs : {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadSoldeConges()
    {
        if (_disposed) return;

        try
        {
            // Appel API réel à implémenter
            await Task.Delay(100, _cancellationTokenSource.Token);

            if (!_disposed)
            {
                _soldeConges = new SoldeConges
                {
                    CongesPayes = 30,
                    RTT = 10,
                    UtilisesCeMois = 2
                };
            }
        }
        catch (OperationCanceledException)
        {
            // Opération annulée, ne rien faire
        }
        catch (Exception ex) when (!_disposed)
        {
            Snackbar?.Add($"Erreur lors du chargement du solde : {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadExistingDemande()
    {
        if (Id.HasValue && !_disposed)
        {
            try
            {
                var result = await DemandeService.GetByIdAsync(Id.Value);

                if (!_disposed && result != null)
                {
                    _currentDemande = result.Data;
                    _demandeModel.TypeConge = _currentDemande.TypeConge ?? "";
                    _demandeModel.DateDebut = _currentDemande.DateDebut;
                    _demandeModel.DateFin = _currentDemande.DateFin;
                    _demandeModel.Motif = _currentDemande.Motif ?? "";
                    _demandeModel.ValidateurEmail = "";
                    _demandeModel.DemiJournee = false;
                    _demandeModel.Confirmation = true;
                }
                else if (!_disposed)
                {
                    Snackbar?.Add("Demande non trouvée", Severity.Error);
                    NavigationManager?.NavigateTo("/demandes");
                }
            }
            catch (Exception ex) when (!_disposed)
            {
                Snackbar?.Add($"Erreur lors du chargement de la demande : {ex.Message}", Severity.Error);
                NavigationManager?.NavigateTo("/demandes");
            }
        }
    }

    private void OnDateChanged()
    {
        if (!_disposed)
        {
            CalculateNombreJours();
        }
    }

    private void CalculateNombreJours()
    {
        if (_disposed) return;

        if (_demandeModel.DateDebut.HasValue && _demandeModel.DateFin.HasValue
            && _demandeModel.DateFin >= _demandeModel.DateDebut)
        {
            var days = 0;
            var current = _demandeModel.DateDebut.Value;
            while (current <= _demandeModel.DateFin.Value)
            {
                if (current.DayOfWeek != DayOfWeek.Saturday && current.DayOfWeek != DayOfWeek.Sunday)
                {
                    days++;
                }
                current = current.AddDays(1);
            }
            _calculatedDays = _demandeModel.DemiJournee ? Math.Max(1, days) : days;
        }
        else
        {
            _calculatedDays = 0;
        }

        if (!_disposed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleSubmit()
    {
        if (_disposed || _isLoading) return;

        _isLoading = true;
        try
        {
            if (!ValidateForm())
                return;

            var request = new DemandeCongeRequestDto
            {
                DateDebut = _demandeModel.DateDebut!.Value,
                DateFin = _demandeModel.DateFin!.Value,
                Motif = _demandeModel.Motif
            };

            if (_isEditMode && _currentDemande != null)
            {
                await DemandeService.UpdateAsync(_currentDemande.Id, request);
                if (!_disposed)
                {
                    Snackbar?.Add("Demande modifiée avec succès !", Severity.Success);
                }
            }
            else
            {
                await DemandeService.CreateAsync(request);
                if (!_disposed)
                {
                    Snackbar?.Add("Demande créée avec succès !", Severity.Success);
                }
            }

            if (!_disposed)
            {
                NavigationManager?.NavigateTo("/mes-demandes");
            }
        }
        catch (Exception ex) when (!_disposed)
        {
            Snackbar?.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            if (!_disposed)
            {
                _isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool ValidateForm()
    {
        if (_disposed) return false;

        if (_demandeModel.DateDebut < DateTime.Today.AddDays(1))
        {
            Snackbar?.Add("La date de début ne peut pas être dans le passé", Severity.Error);
            return false;
        }
        if (_demandeModel.DateFin < _demandeModel.DateDebut)
        {
            Snackbar?.Add("La date de fin ne peut pas être antérieure à la date de début", Severity.Error);
            return false;
        }
        if (_calculatedDays == 0)
        {
            Snackbar?.Add("La période sélectionnée ne contient aucun jour ouvré", Severity.Error);
            return false;
        }
        return true;
    }

    private void ResetForm()
    {
        if (_disposed) return;

        if (_currentDemande != null)
        {
            _demandeModel.TypeConge = _currentDemande.TypeConge ?? "";
            _demandeModel.DateDebut = _currentDemande.DateDebut;
            _demandeModel.DateFin = _currentDemande.DateFin;
            _demandeModel.Motif = _currentDemande.Motif ?? "";
            _demandeModel.ValidateurEmail = "";
            _demandeModel.DemiJournee = false;
            CalculateNombreJours();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }

    public class DemandeModel
    {
        [Required(ErrorMessage = "Le type de congé est requis")]
        public string TypeConge { get; set; } = "";

        [Required(ErrorMessage = "La date de début est requise")]
        public DateTime? DateDebut { get; set; }

        [Required(ErrorMessage = "La date de fin est requise")]
        public DateTime? DateFin { get; set; }

        [StringLength(500, ErrorMessage = "Le motif ne peut pas dépasser 500 caractères")]
        public string Motif { get; set; } = "";

        [Required(ErrorMessage = "Vous devez sélectionner un validateur")]
        public string ValidateurEmail { get; set; } = "";

        public bool Confirmation { get; set; }
        public bool DemiJournee { get; set; }
    }

    public class SoldeConges
    {
        public int CongesPayes { get; set; }
        public int RTT { get; set; }
        public int UtilisesCeMois { get; set; }
    }
}