@page "/demandes"
@layout MainLayout
@using MudBlazor    
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using GestionConge.Client.Services
@attribute [Authorize]
@using GestionConge.Client.Models
@using GestionConge.Client.Layout
@using GestionConge.Client.Extensions
@using GestionConge.Client.Helpers
@* @layout SecureLayout *@
@inject DemandeCongeService DemandeService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Mes demandes - GCO</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <MudText Typo="Typo.h4" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-3" />
            Mes demandes de congés
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Gérez vos demandes de congés et consultez leur statut
        </MudText>
    </div>
    <MudButton Href="/demandes/nouvelle"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">
        Nouvelle demande
    </MudButton>
</div>

<!-- Filtres -->
<MudCard Class="mb-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_filtreStatut" Label="Statut" 
                          Variant="Variant.Outlined" @onchange="ApplyFilters">
                    <MudSelectItem Value="@("")">Tous les statuts</MudSelectItem>
                    <MudSelectItem Value="@("En attente")">En attente</MudSelectItem>
                    <MudSelectItem Value="@("Approuvé")">Approuvé</MudSelectItem>
                    <MudSelectItem Value="@("Rejeté")">Rejeté</MudSelectItem>
                    <MudSelectItem Value="@("Annulé")">Annulé</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_filtreType" Label="Type de congé" 
                          Variant="Variant.Outlined" @onchange="ApplyFilters">
                    <MudSelectItem Value="@("")">Tous les types</MudSelectItem>
                    <MudSelectItem Value="@("Congés payés")">Congés payés</MudSelectItem>
                    <MudSelectItem Value="@("RTT")">RTT</MudSelectItem>
                    <MudSelectItem Value="@("Congé maladie")">Congé maladie</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDateRangePicker @bind-DateRange="_filtrePeriode" Label="Période" 
                                   Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-items-end">
                <MudButton Variant="Variant.Outlined" 
                          StartIcon="@Icons.Material.Filled.Clear"
                          OnClick="ClearFilters">
                    Effacer les filtres
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Statistiques rapides -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Primary">@_filteredDemandes.Count</MudText>
            <MudText Typo="Typo.body2">Total</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Warning">
                @_filteredDemandes.Count(d => d.Statut == "En attente")
            </MudText>
            <MudText Typo="Typo.body2">En attente</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Success">
                @_filteredDemandes.Count(d => d.Statut == "Approuvé")
            </MudText>
            <MudText Typo="Typo.body2">Approuvées</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Error">
                @_filteredDemandes.Count(d => d.Statut == "Rejeté")
            </MudText>
            <MudText Typo="Typo.body2">Rejetées</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Liste des demandes -->
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                Liste des demandes (@_filteredDemandes.Count)
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@(_viewMode == "table" ? Icons.Material.Filled.TableRows : Icons.Material.Filled.ViewModule)"
                          OnClick="ToggleViewMode" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_loading)
        {
            <div class="text-center pa-4">
                <MudProgressCircular Indeterminate="true" />
                <MudText Class="mt-2">Chargement des demandes...</MudText>
            </div>
        }
        else if (!_filteredDemandes.Any())
        {
            <div class="text-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">Aucune demande trouvée</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Créez votre première demande de congé
                </MudText>
                <MudButton Class="mt-4" Href="/demandes/nouvelle" 
                          Variant="Variant.Filled" Color="Color.Primary">
                    Nouvelle demande
                </MudButton>
            </div>
        }
        else
        {
            @if (_viewMode == "table")
            {
                <MudDataGrid T="DemandeCongeDto" Items="_filteredDemandes" 
                            Sortable="true" Filterable="false"
                            RowsPerPage="10">
                    <Columns>
                        <PropertyColumn Property="x => x.DateSoumission" Title="Soumise le" 
                                       Format="dd/MM/yyyy" />
                        <PropertyColumn Property="x => x.DateDebut" Title="Début" 
                                       Format="dd/MM/yyyy" />
                        <PropertyColumn Property="x => x.DateFin" Title="Fin" 
                                       Format="dd/MM/yyyy" />
                        <PropertyColumn Property="x => x.TypeConge" Title="Type" />
                        @* <PropertyColumn Property="x => x.NombreJours" Title="Jours" /> *@
                        <TemplateColumn Title="Statut">
                            <CellTemplate>
                                <MudChip Color="@GetStatusColor(context.Item.Statut)" 
                                        Size="Size.Small">
                                    @context.Item.Statut
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                              OnClick="@(() => ViewDemande(context.Item.Id))" 
                                              Size="Size.Small" />
                                @if (context.Item.Statut == "En attente")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                  OnClick="@(() => EditDemande(context.Item.Id))" 
                                                  Size="Size.Small" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                  OnClick="@(() => DeleteDemande(context.Item))" 
                                                  Size="Size.Small" 
                                                  Color="Color.Error" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            }
            else
            {
                <MudGrid>
                    @foreach (var demande in _filteredDemandes)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Class="h-100">
                                <MudCardHeader>
                                  <MudCardContent>
                                    
                                        <div class="d-flex justify-content-between align-items-center">
                                            <MudChip T="string" Color="@GetStatusColor(demande.Statut)" 
                                                    Size="Size.Small">
                                                @demande.Statut
                                            </MudChip>
                                    @*         <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @demande.NombreJours jour@(demande.NombreJours > 1 ? "s" : "")
                                    </MudText> *@
                                    @if (!string.IsNullOrEmpty(demande.CommentaireValidation))
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-2">
                                            @(demande.CommentaireValidation.Length > 80 ? 
                                              demande.CommentaireValidation.Substring(0, 80) + "..." : 
                                              demande.CommentaireValidation)
                                        </MudText>
                                    }
                                         </div>
                                    
                                  </MudCardContent>
                                </MudCardHeader>
                            
                                <MudCardActions>
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                                  OnClick="@(() => ViewDemande(demande.Id))" 
                                                  Size="Size.Small" />
                                    @if (demande.Statut == "En attente")
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                      OnClick="@(() => EditDemande(demande.Id))" 
                                                      Size="Size.Small" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                      OnClick="@(() => DeleteDemande(demande))" 
                                                      Size="Size.Small" 
                                                      Color="Color.Error" />
                                    }
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </MudCardContent>
</MudCard>

@code {
    private bool _loading = true;
    private List<DemandeCongeDto> _demandes = new();
    private List<DemandeCongeDto> _filteredDemandes = new();
    private string _viewMode = "table";

    // Filtres
    private string _filtreStatut = "";
    private string _filtreType = "";
    private DateRange? _filtrePeriode;

    protected override async Task OnInitializedAsync()
    {
        await LoadMesDemandes();
    }

    private async Task LoadMesDemandes()
    {
        _loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            // var userId = authState.User.GetUserId();
            // Remplacez la ligne suivante :
            // var userId = authState.User.GetUserId();

            // Par :
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            int? userId = null;
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var parsedId))
            {
                userId = parsedId;
            }

            if (userId.HasValue)
            {
                var result = await DemandeService.GetByUtilisateurAsync(userId.Value);
                await result.HandleServiceResultAsync(Snackbar,
                    successMessage: "Demandes chargées avec succès",
                    onSuccess: demandes => 
                    {
                        _demandes = demandes.ToList();
                        ApplyFilters();
                    });
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur lors du chargement des demandes : {ex.Message}");
            Snackbar.Add("Erreur lors du chargement des demandes", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        _filteredDemandes = _demandes.Where(d =>
            (string.IsNullOrEmpty(_filtreStatut) || d.Statut == _filtreStatut) &&
            (string.IsNullOrEmpty(_filtreType) || d.TypeConge == _filtreType) &&
            (_filtrePeriode == null || 
             (d.DateDebut >= _filtrePeriode.Start && d.DateFin <= _filtrePeriode.End))
        ).OrderByDescending(d => d.DateSoumission).ToList();

        StateHasChanged();
    }

    private void ClearFilters()
    {
        _filtreStatut = "";
        _filtreType = "";
        _filtrePeriode = null;
        ApplyFilters();
    }

    private void ToggleViewMode()
    {
        _viewMode = _viewMode == "table" ? "cards" : "table";
    }

    private Color GetStatusColor(string statut)
    {
        return statut switch
        {
            "En attente" => Color.Warning,
            "Approuvé" => Color.Success,
            "Rejeté" => Color.Error,
            "Annulé" => Color.Secondary,
            _ => Color.Default
        };
    }

    private void ViewDemande(int id)
    {
        NavigationManager.NavigateTo($"/demandes/details/{id}");
    }

    private void EditDemande(int id)
    {
        NavigationManager.NavigateTo($"/demandes/modifier/{id}");
    }

    [Inject] private IDialogService DialogService { get; set; }

    public Demandes(IDialogService dialogService)
    {
        DialogService = dialogService;
    }

    private async Task DeleteDemande(DemandeCongeDto demande)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Confirmer la suppression",
            "Êtes-vous sûr de vouloir supprimer cette demande ?",
            yesText: "Oui",
            noText: "Non"
        );

        if (confirmed == true)
        {
            var result = await DemandeService.DeleteAsync(demande.Id);
            if (result.HandleWithNotification(Snackbar))
            {
                await LoadMesDemandes();
            }
        }
    }
}