@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Bienvenue - GCO</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    @if (isAuthenticated)
    {
        <!-- Redirection automatique vers le dashboard -->
        <MudContainer MaxWidth="MaxWidth.Medium" Class="text-center">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="mt-4">Redirection en cours...</MudText>
        </MudContainer>
    }
    else
    {
        <!-- Page d'accueil pour utilisateurs non connectés -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="8" lg="6">
                <MudPaper Elevation="4" Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.BusinessCenter"
                             Size="Size.Large"
                             Color="Color.Primary"
                             Class="mb-4" />
                    <MudText Typo="Typo.h3" Color="Color.Primary" GutterBottom="true">
                        Bienvenue sur GCO
                    </MudText>
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-6">
                        Système de Gestion de Congés d'Entreprise
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mb-6">
                        Gérez facilement vos demandes de congés, consultez vos soldes
                        et suivez l'état de vos demandes en temps réel.
                    </MudText>

                    <MudStack Row Justify="Justify.Center" Spacing="4" Class="mb-6">
                        <MudButton Href="/login"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Login">
                            Se connecter
                        </MudButton>
                        <MudButton Href="/register"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            S'inscrire
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Fonctionnalités -->
        <MudGrid Class="mt-8">
            <MudItem xs="12" md="4">
                <MudCard Class="h-100">
                    <MudCardContent Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                                 Size="Size.Large"
                                 Color="Color.Info"
                                 Class="mb-3" />
                        <MudText Typo="Typo.h6" GutterBottom="true">
                            Gestion Simplifiée
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Créez et gérez vos demandes de congés en quelques clics
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Class="h-100">
                    <MudCardContent Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Large"
                                 Color="Color.Success"
                                 Class="mb-3" />
                        <MudText Typo="Typo.h6" GutterBottom="true">
                            Validation Rapide
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Processus de validation automatisé et notifications en temps réel
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Class="h-100">
                    <MudCardContent Class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics"
                                 Size="Size.Large"
                                 Color="Color.Warning"
                                 Class="mb-3" />
                        <MudText Typo="Typo.h6" GutterBottom="true">
                            Suivi Complet
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Consultez vos soldes et historiques de congés
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            // Redirection vers dashboard après une petite pause
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/dashboard");
        }
    }
}