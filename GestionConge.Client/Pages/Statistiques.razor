@page "/statistiques"
    @using GestionConge.Client.Layout
@using Microsoft.AspNetCore.Authorization
@using GestionConge.Client.Services
@using GestionConge.Client.Models
    @attribute [Authorize]

@inject GestionConge.Client.Services.StatistiqueService StatistiqueService

<h3>Statistiques</h3>

@if (statistiques == null)
{
    <p>Chargement des statistiques...</p>
}
else
{
    <ul>
        <li>Total des demandes : @statistiques.TotalDemandesConge</li>
        <li>Demandes validées : @statistiques.TotalDemandesApprouvees</li>
        <li>Demandes refusées : @statistiques.TotalDemandesRefusees</li>
        <li>Utilisateurs inscrits : @statistiques.TotalEmployes</li>
    </ul>
    @* <ChartComponent Data="@statistiques.ChartData" /> *@
}

@code {
    private GestionConge.Client.Models.StatistiquesDto? statistiques;

    protected override async Task OnInitializedAsync()
    {
        statistiques = await StatistiqueService.GetStatistiquesAsync();
    }
}
