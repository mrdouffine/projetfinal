@page "/validations"
@layout MainLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using GestionConge.Client.Services
@attribute [Authorize]
@using GestionConge.Client.Models
@using GestionConge.Client.Layout
@using GestionConge.Client.Extensions
@using GestionConge.Client.Helpers
@inject NavigationManager NavigationManager
@inject ValidationService ValidationService
@inject DemandeCongeService DemandeService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<PageTitle>Validations en attente - GCO</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <MudText Typo="Typo.h4" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-3" />
            Validations en attente
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Gérez les demandes de congés soumises par votre équipe
        </MudText>
    </div>
    <MudButton OnClick="RefreshData"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_loading">
        Actualiser
    </MudButton>
</div>

<!-- Statistiques -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Warning">@_validationsEnAttente.Count</MudText>
            <MudText Typo="Typo.body2">En attente</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Error">@_validationsUrgentes.Count</MudText>
            <MudText Typo="Typo.body2">Urgentes</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Success">@_validationsAujourdhui</MudText>
            <MudText Typo="Typo.body2">Validées aujourd'hui</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4 text-center">
            <MudText Typo="Typo.h6" Color="Color.Info">@GetTempsReponseMoyen()</MudText>
            <MudText Typo="Typo.body2">Temps de réponse moyen</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Filtres -->
<MudCard Class="mb-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_filtreUrgence" Label="Priorité"
                           Variant="Variant.Outlined" @onchange="ApplyFilters">
                    <MudSelectItem Value="@("")">Toutes</MudSelectItem>
                    <MudSelectItem Value="@("urgent")">Urgentes</MudSelectItem>
                    <MudSelectItem Value="@("normal")">Normales</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_filtreType" Label="Type de congé"
                           Variant="Variant.Outlined" @onchange="ApplyFilters">
                    <MudSelectItem Value="@("")">Tous les types</MudSelectItem>
                    <MudSelectItem Value="@("Congés payés")">Congés payés</MudSelectItem>
                    <MudSelectItem Value="@("RTT")">RTT</MudSelectItem>
                    <MudSelectItem Value="@("Congé maladie")">Congé maladie</MudSelectItem>
                </MudSelect>
            </MudItem>
            <!-- Nouveau filtre pour le rôle -->
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_filtreRole" Label="Niveau de validation"
                           Variant="Variant.Outlined" @onchange="ApplyFilters">
                    <MudSelectItem Value="@("")">Tous les niveaux</MudSelectItem>
                    <MudSelectItem Value="@("normal")">Validation initiale</MudSelectItem>
                    <MudSelectItem Value="@("dot")">Validation DOT</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string" @bind-Value="_filtreEmploye" Label="Rechercher employé"
                              Variant="Variant.Outlined" @onchange="ApplyFilters"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-items-end">
                <MudButton Variant="Variant.Outlined" OnClick="ClearFilters" FullWidth="true">
                    Effacer les filtres
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Liste des demandes -->
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                Demandes à valider (@_filteredValidations.Count)
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@(_viewMode == "table" ? Icons.Material.Filled.TableRows : Icons.Material.Filled.ViewModule)"
                           OnClick="ToggleViewMode" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_loading)
        {
            <div class="text-center pa-4">
                <MudProgressCircular Indeterminate="true" />
                <MudText Class="mt-2">Chargement des demandes...</MudText>
            </div>
        }
        else if (!_filteredValidations.Any())
        {
            <div class="text-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mb-4" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">Aucune demande en attente</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Toutes les demandes ont été traitées
                </MudText>
            </div>
        }
        else
        {
            @if (_viewMode == "table")
            {
                <MudDataGrid T="Validation" Items="_filteredValidations"
                             Sortable="true" Filterable="false"
                             RowsPerPage="10">
                    <Columns>
                        <TemplateColumn Title="Priorité" Sortable="false">
                            <CellTemplate>
                                @if (IsUrgent(context.Item))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.NomValideur" Title="Employé" />
                        <PropertyColumn Property="x => x.DateValidation" Title="Soumise le" Format="dd/MM/yyyy" />
                        <TemplateColumn Title="Niveau" Sortable="true" Filterable="true">
                            <CellTemplate>
                                @if (IsDotValidation(context.Item))
                                {
                                    <MudChip Color="Color.Primary" Size="Size.Small">DOT</MudChip>
                                }
                                else
                                {
                                    <MudChip Color="Color.Secondary" Size="Size.Small">Initial</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                    <MudButton Color="Color.Info"
                                               OnClick="@(() => VoirDetails(context.Item.Id))"
                                               StartIcon="@Icons.Material.Filled.Visibility">
                                        Détails
                                    </MudButton>
                                    <MudButton Color="Color.Success"
                                               OnClick="@(() => ApprouverDemande(context.Item))"
                                               StartIcon="@Icons.Material.Filled.Check">
                                        Approuver
                                    </MudButton>
                                    <MudButton Color="Color.Error"
                                               OnClick="@(() => RejeterDemande(context.Item))"
                                               StartIcon="@Icons.Material.Filled.Close">
                                        Rejeter
                                    </MudButton>
                                </MudButtonGroup>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            }
            else
            {
                <MudGrid>
                    @foreach (var validation in _filteredValidations)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Class="h-100" Style="@(IsUrgent(validation) ? "border-left: 4px solid red;" : "")">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <MudText Typo="Typo.h6">@validation.NomValideur</MudText>
                                            <div class="d-flex gap-2">
                                                @if (IsUrgent(validation))
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.PriorityHigh"
                                                             Color="Color.Error"
                                                             Title="Demande urgente" />
                                                }
                                                @if (IsDotValidation(validation))
                                                {
                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">DOT</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Initial</MudChip>
                                                }
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Soumise le @validation.DateValidation.ToString("dd/MM/yyyy")
                                        </MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (!string.IsNullOrEmpty(validation.Commentaire))
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-2">
                                            "@validation.Commentaire"
                                        </MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   OnClick="@(() => VoirDetails(validation.Id))"
                                                   Size="Size.Small" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                   OnClick="@(() => ApprouverDemande(validation))"
                                                   Size="Size.Small"
                                                   Color="Color.Success" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   OnClick="@(() => RejeterDemande(validation))"
                                                   Size="Size.Small"
                                                   Color="Color.Error" />
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </MudCardContent>
</MudCard>

<!-- Dialog de validation - VERSION CORRIGÉE -->
@if (_showApproveDialog)
{
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Check" Class="mr-3" />
                Approuver la demande
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudText GutterBottom="true">
                Êtes-vous sûr de vouloir approuver la demande de <strong>@_selectedValidation?.NomValideur</strong> ?
            </MudText>
            <MudTextField @bind-Value="_commentaireApprobation"
                          Label="Commentaire (facultatif)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          HelperText="Ajoutez un commentaire si nécessaire" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showApproveDialog = false)">Annuler</MudButton>
            <MudButton Color="Color.Success" OnClick="ConfirmApprobation">
                Approuver
            </MudButton>
        </DialogActions>
    </MudDialog>
}

<!-- Dialog de rejet - VERSION CORRIGÉE -->
@if (_showRejectDialog)
{
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Close" Class="mr-3" />
                Rejeter la demande
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudText GutterBottom="true">
                Êtes-vous sûr de vouloir rejeter la demande de <strong>@_selectedValidation?.NomValideur</strong> ?
            </MudText>
            <MudTextField @bind-Value="_commentaireRejet"
                          Label="Commentaire (obligatoire)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Required="true"
                          HelperText="Expliquez la raison du rejet" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showRejectDialog = false)">Annuler</MudButton>
            <MudButton Color="Color.Error"
                       OnClick="ConfirmRejet"
                       Disabled="string.IsNullOrWhiteSpace(_commentaireRejet)">
                Rejeter
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private bool _loading = true;
    private List<Validation> _validationsEnAttente = new();
    private List<Validation> _filteredValidations = new();
    private List<Validation> _validationsUrgentes = new();
    private int _validationsAujourdhui = 0;
    private string _viewMode = "table";

    // Filtres
    private string _filtreUrgence = "";
    private string _filtreType = "";
    private string _filtreRole = ""; // Nouveau filtre pour le rôle
    private string _filtreEmploye = "";

    // Dialogs
    private bool _showApproveDialog = false;
    private bool _showRejectDialog = false;
    private Validation? _selectedValidation;
    private string _commentaireApprobation = "";
    private string _commentaireRejet = "";


    //methode pour récupérer l'id utilisateur DOT depuis le service d'authentification
    // private async Task<List<int>> GetDotUserIdAsync()
    // {
    //     var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    //     var user = authState.User.GetUserId;


    //     var  DOT_USER_ID = await ValidationService.GetDotIdsAsync();
    //     return DOT_USER_ID;

    // }
    // stocker les id utilisateur DOT dans une constante pour la comparaison DOT_USER_ID

    private List<int> result = new();







    protected override async Task OnInitializedAsync()
    {
        await LoadValidationEnAttente();
    }

    private async Task LoadValidationEnAttente()
    {
        _loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var validateurId = authState.User.GetUserId();

            if (validateurId.HasValue)
            {
                var result = await ValidationService.GetValidationsByValidateurAsync(validateurId.Value);

                if (result.IsSuccess)
                {
                    Console.WriteLine($"Found {result.Data.Count()} validations.");
                    _validationsEnAttente = result.Data.ToList();
                    _validationsUrgentes = _validationsEnAttente.Where(IsUrgent).ToList();
                    ApplyFilters(); // Apply filters immediately after loading data

                    // Load stats after data is successfully loaded
                    await LoadStatistiques();
                }
                else
                {
                    Snackbar.Add(result.ErrorMessage ?? "Une erreur est survenue lors du chargement des demandes.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur lors du chargement des demandes : {ex.Message}");
            Snackbar.Add("Erreur lors du chargement des demandes à valider", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadStatistiques()
    {
        var result = await ValidationService.GetValidationsAujourdhuiAsync();
        if (result.IsSuccess)
        {
            _validationsAujourdhui = result.Data.Count(); // Assuming result.Data is an integer
        }
        else
        {
            Snackbar.Add("Erreur lors du chargement des statistiques", Severity.Error);
        }
    }

    private void ApplyFilters()
    {
        _filteredValidations = _validationsEnAttente.Where(v =>
            (_filtreUrgence == "" ||
            (_filtreUrgence == "urgent" && IsUrgent(v)) ||
            (_filtreUrgence == "normal" && !IsUrgent(v))) &&
            (_filtreRole == "" ||
            (_filtreRole == "DOT" && IsDotValidation(v)) ||
            (_filtreRole == "normal" && !IsDotValidation(v))) &&
            (string.IsNullOrEmpty(_filtreType)) &&
            (string.IsNullOrEmpty(_filtreEmploye) ||
            v.NomValideur.Contains(_filtreEmploye, StringComparison.OrdinalIgnoreCase))
        ).OrderBy(v => IsUrgent(v) ? 0 : 1)
         .ThenBy(v => v.DateValidation)
         .ToList();

        StateHasChanged();
    }

    private void ClearFilters()
    {
        _filtreUrgence = "";
        _filtreType = "";
        _filtreRole = ""; // Réinitialiser le nouveau filtre
        _filtreEmploye = "";
        ApplyFilters();
    }

    private void ToggleViewMode()
    {
        _viewMode = _viewMode == "table" ? "cards" : "table";
    }

    private bool IsUrgent(Validation validation)
    {
        // Une demande est urgente si :
        // - Elle a été soumise il y a plus de 5 jours
        return (DateTime.Today - validation.DateValidation.Date).Days > 5;
    }

    // Nouvelle méthode pour vérifier si la validation est destinée au DOT
    private bool IsDotValidation(Validation validation)
    {
        //recupérer les id utilisateur DOT depuis la méthode GetDotUserIdAsync
        
        return false;
    }

    private string GetTempsReponseMoyen()
    {
        // Simuler un temps de réponse moyen
        return "2.3j";
    }

    private void VoirDetails(int validationId) => NavigationManager.NavigateTo($"/validations/details/{validationId}");

    private void ApprouverDemande(Validation validation)
    {
        Console.WriteLine($"ApprouverDemande appelée pour validation ID: {validation.Id}");
        Console.WriteLine($"DemandeCongeId: {validation.DemandeCongeId}");
        Console.WriteLine($"NomValideur: {validation.NomValideur}");

        _selectedValidation = validation;
        _commentaireApprobation = "";
        _showApproveDialog = true;

        Console.WriteLine($"Dialog ouvert: {_showApproveDialog}");
        StateHasChanged(); // Force UI update
    }

    private void RejeterDemande(Validation validation)
    {
        Console.WriteLine($"RejeterDemande appelée pour validation ID: {validation.Id}");
        Console.WriteLine($"DemandeCongeId: {validation.DemandeCongeId}");
        Console.WriteLine($"NomValideur: {validation.NomValideur}");

        _selectedValidation = validation;
        _commentaireRejet = "";
        _showRejectDialog = true;

        Console.WriteLine($"Dialog ouvert: {_showRejectDialog}");
        StateHasChanged(); // Force UI update
    }

    private async Task ConfirmApprobation()
    {
        Console.WriteLine("ConfirmApprobation démarrée");

        if (_selectedValidation == null)
        {
            Console.WriteLine("Erreur: _selectedValidation est null");
            return;
        }

        Console.WriteLine($"Validation sélectionnée: ID={_selectedValidation.Id}, DemandeCongeId={_selectedValidation.DemandeCongeId}");

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var validateurId = authState.User.GetUserId();

            Console.WriteLine($"ValidateurId récupéré: {validateurId}");

            if (validateurId.HasValue)
            {
                Console.WriteLine($"Appel API ApprouverDemandeAsync avec DemandeCongeId: {_selectedValidation.DemandeCongeId}");

                var result = await ValidationService.ApprouverDemandeAsync(
                    _selectedValidation.DemandeCongeId,
                    validateurId.Value,
                    _commentaireApprobation);

                Console.WriteLine($"Résultat API: IsSuccess={result.IsSuccess}");

                if (!result.IsSuccess)
                {
                    Console.WriteLine($"Erreur API: {result.ErrorMessage}");
                }

                if (result.IsSuccess)
                {
                    Console.WriteLine("Approbation réussie - affichage du message de succès");
                    Snackbar.Add("Demande approuvée avec succès", Severity.Success);
                    _showApproveDialog = false;
                    Console.WriteLine("Début du refresh des données");
                    await RefreshData();
                    Console.WriteLine("Refresh des données terminé");
                }
                else
                {
                    Snackbar.Add(result.ErrorMessage ?? "Erreur lors de l'approbation", Severity.Error);
                }
            }
            else
            {
                Console.WriteLine("Erreur: validateurId est null");
                Snackbar.Add("Erreur d'authentification", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Exception dans ConfirmApprobation: {ex.Message}");
            Console.Error.WriteLine($"StackTrace: {ex.StackTrace}");
            Snackbar.Add("Erreur lors de l'approbation de la demande", Severity.Error);
        }
    }

    private async Task ConfirmRejet()
    {
        Console.WriteLine("ConfirmRejet démarrée");

        if (_selectedValidation == null || string.IsNullOrWhiteSpace(_commentaireRejet))
        {
            Console.WriteLine($"Erreur: _selectedValidation null={_selectedValidation == null}, commentaire vide={string.IsNullOrWhiteSpace(_commentaireRejet)}");
            return;
        }

        Console.WriteLine($"Validation sélectionnée: ID={_selectedValidation.Id}, DemandeCongeId={_selectedValidation.DemandeCongeId}");

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var validateurId = authState.User.GetUserId();

            Console.WriteLine($"ValidateurId récupéré: {validateurId}");

            if (validateurId.HasValue)
            {
                Console.WriteLine($"Appel API RejeterDemandeAsync avec DemandeCongeId: {_selectedValidation.DemandeCongeId}");

                var result = await ValidationService.RejeterDemandeAsync(
                    _selectedValidation.DemandeCongeId,
                    validateurId.Value,
                    _commentaireRejet);

                Console.WriteLine($"Résultat API: IsSuccess={result.IsSuccess}");

                if (!result.IsSuccess)
                {
                    Console.WriteLine($"Erreur API: {result.ErrorMessage}");
                }

                if (result.IsSuccess)
                {
                    Console.WriteLine("Rejet réussi - affichage du message de succès");
                    Snackbar.Add("Demande rejetée avec succès", Severity.Success);
                    _showRejectDialog = false;
                    Console.WriteLine("Début du refresh des données");
                    await RefreshData();
                    Console.WriteLine("Refresh des données terminé");
                }
                else
                {
                    Snackbar.Add(result.ErrorMessage ?? "Erreur lors du rejet", Severity.Error);
                }
            }
            else
            {
                Console.WriteLine("Erreur: validateurId est null");
                Snackbar.Add("Erreur d'authentification", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Exception dans ConfirmRejet: {ex.Message}");
            Console.Error.WriteLine($"StackTrace: {ex.StackTrace}");
            Snackbar.Add("Erreur lors du rejet de la demande", Severity.Error);
        }
    }


    private async Task RefreshData()
    {
        await LoadValidationEnAttente();
    }
}
